managed implementation in class zbp_i_srm_disruption unique;
strict ( 2 );
with draft;

define behavior for ZI_SRM_DISRUPTION alias Disruption
persistent table ZSRM_DISRUPTION
draft table zsrm_disr_d
lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( none )
{
  create;
  update;
  delete;

  field ( readonly : update )
    DisruptionId;

  field ( readonly )
    ImpactedDays,
    AIAnalysis,
    LocalCreatedBy,
    LocalCreatedAt,
    LocalLastChangedBy,
    LocalLastChangedAt,
    LastChangedAt;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;

  draft determine action Prepare { }

  determination analyzeDisruption on modify
  {
    create;
    field VendorId,
          PoId,
          DisruptionType,
          DisruptionTitle,
          DisruptionDescription,
          Severity,
          ImpactArea,
          StartDate,
          EndDate,
          SourceType,
          SourceReference;
  }

  mapping for ZSRM_DISRUPTION
  {
    DisruptionId           = disruption_id;
    VendorId               = vendor_id;
    PoId                   = po_id;

    DisruptionType         = disruption_type;
    DisruptionTitle        = disruption_title;
    DisruptionDescription  = disruption_description;

    Severity               = severity;
    ImpactArea             = impact_area;

    StartDate              = start_date;
    EndDate                = end_date;
    ImpactedDays           = impacted_days;

    SourceType             = source_type;
    SourceReference        = source_reference;

    AIAnalysis             = ai_analysis;

    EventStatus            = event_status;

    LocalCreatedBy         = local_created_by;
    LocalCreatedAt         = local_created_at;
    LocalLastChangedBy     = local_last_changed_by;
    LocalLastChangedAt     = local_last_changed_at;
    LastChangedAt          = last_changed_at;
  }
}