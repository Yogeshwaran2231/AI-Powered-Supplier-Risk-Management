@Metadata.layer: #CORE

@UI.headerInfo: {
  typeName: 'Purchase Order',
  typeNamePlural: 'Purchase Orders',
  title: {
    type: #STANDARD,
    value: 'PoId'
  },
  description: {
    type: #STANDARD,
    value: 'PoStatus'
  }
}

@UI.presentationVariant: [{
  sortOrder: [{
    by: 'PoDate',
    direction: #DESC
  }],
  visualizations: [{
    type: #AS_LINEITEM
  }]
}]
annotate entity zc_srm_po_hdr
    with 
{
    @UI.facet: [
    {
      id: 'POHeader',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Purchase Order Details',
      position: 10
    },
    {
      id: 'POItems',
      purpose: #STANDARD,
      type: #LINEITEM_REFERENCE,
      label: 'Purchase Order Items',
      position: 20,
      targetElement: '_Items'
    }
  ]

  @UI: {
    lineItem: [
      {
        position: 10,
        importance: #HIGH,
        label: 'PO ID'
      }
    ],
    identification: [
      {
        position: 10,
        label: 'PO ID'
      }
    ],
    selectionField: [
      {
        position: 10
      }
    ]
  }
  PoId;

  @UI: {
    lineItem: [
      {
        position: 20,
        importance: #HIGH,
        label: 'Vendor ID'
      }
    ],
    identification: [
      {
        position: 20,
        label: 'Vendor ID'
      }
    ],
