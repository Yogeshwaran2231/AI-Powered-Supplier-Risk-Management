managed implementation in class zbp_i_srm_invoice unique;
strict ( 2 );
with draft;
define behavior for zi_srm_invoice alias Invoice
persistent table zsrm_invoice
draft table zsrm_invoice_d
lock master
total etag LastChangedAt
etag master LocalLastChangedAt
authorization master ( none )
{
  create;
  update;
  delete;
   field ( readonly : update ) InvoiceId;

   field ( readonly )

    InvoiceTotalAmount,
    PoTotalAmount,
    AmountVariance,
    MatchStatus,
    LocalCreatedBy,
    LocalCreatedAt,
    LocalLastChangedBy,
    LocalLastChangedAt,
    LastChangedAt;

  draft action Edit;
  draft action Activate;
  draft action Discard;
  draft action Resume;

   draft determine action Prepare { }

   determination calculateInvoiceAnalysis on modify
  {
    create;
    field InvoiceNetAmount,
          InvoiceTaxAmount,
          PoId;
  }

  mapping for zsrm_invoice
  {
    InvoiceId            = invoice_id;
    PoId                 = po_id;
    VendorId             = vendor_id;

    InvoiceDate          = invoice_date;
    DueDate              = due_date;

    CurrencyCode         = currency_code;

    InvoiceNetAmount     = invoice_net_amount;
    InvoiceTaxAmount     = invoice_tax_amount;
    InvoiceTotalAmount   = invoice_total_amount;

    PoTotalAmount        = po_total_amount;
    AmountVariance       = amount_variance;

    MatchStatus          = match_status;
    InvoiceStatus        = invoice_status;
    PaymentStatus        = payment_status;

    LocalCreatedBy       = local_created_by;
    LocalCreatedAt       = local_created_at;
    LocalLastChangedBy   = local_last_changed_by;
    LocalLastChangedAt   = local_last_changed_at;
    LastChangedAt        = last_changed_at;
  }
}